# Copy this file to .env.local and fill in your key. .env.local is never committed.
# Get a free key at https://aistudio.google.com/apikey
# Without a key, MiOS uses demo AI answers so every feature still works.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.1-flash-lite, the cheapest stable model with a free tier.
GEMINI_MODEL=

# Google Calendar sync (Section E2): OAuth Client ID, type "Web application".
# Public by design (it ships to the browser). No client secret is used.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: accounts and sync with Firebase (Auth + Firestore). Values from the
# Firebase console's web app config. Public by design; Firestore rules protect the data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# What guests (no account) get from AI: "real" (default for now) or "demo".
# NEXT_PUBLIC_GUEST_AI=demo

# Optional: the Gemini model, and the one used when it's overloaded.
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
